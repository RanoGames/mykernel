/* linker.ld — говорит линкеру, как расположить секции ядра в памяти.
 *
 * Ядро линкуется на адрес 1 МБ (0x100000) — это стандартное место,
 * с которого Multiboot-загрузчики (в т.ч. GRUB) кладут ядро,
 * т.к. ниже 1 МБ находится память, зарезервированная BIOS/железом. */

ENTRY(_start)   /* точка входа — метка _start из boot.s */

SECTIONS
{
    . = 1M;   /* текущий адрес размещения = 1 МБ */

    /* Multiboot-заголовок должен быть в первых 8 КБ ФАЙЛА (не только
     * "адреса в памяти"!), поэтому его секцию размещаем самой первой
     * и явно выбрасываем служебные секции (.note.*, .comment), которые
     * компилятор/линкер добавляют автоматически (например build-id) —
     * без этого линкер может воткнуть их перед .multiboot и сдвинуть
     * заголовок за пределы 8 КБ, из-за чего GRUB/QEMU перестанут его находить */
    .multiboot : {
        *(.multiboot)
    }

    /* Секция исполняемого кода */
    .text : {
        *(.text)
    }

    /* Секция константных (только для чтения) данных */
    .rodata : {
        *(.rodata)
    }

    /* Секция инициализированных глобальных/статических переменных */
    .data : {
        *(.data)
    }

    /* Секция неинициализированных переменных (стек ядра тоже здесь) */
    .bss : {
        *(COMMON)
        *(.bss)
    }

    /* Явно выбрасываем служебные секции, которые компилятор/линкер
     * добавляют сами и которые нашему ядру не нужны. Без этого они
     * могут "втиснуться" линкером перед .multiboot и сломать загрузку
     * (см. комментарий у .multiboot выше) */
    /DISCARD/ : {
        *(.note.*)
        *(.comment)
        *(.eh_frame)
    }
}
